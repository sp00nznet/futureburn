<Window x:Class="Futureburn.Gui.ImageToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Tools"
        Height="560" Width="820"
        MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>

  <DockPanel>

    <ToolBar DockPanel.Dock="Top">
      <TextBlock Text="Drive:" VerticalAlignment="Center" Margin="4,0,6,0"/>
      <ComboBox x:Name="DriveCombo" Width="260"/>
      <Button Content="Refresh" Click="Refresh_Click" Margin="8,0,0,0" Padding="10,2"/>
    </ToolBar>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="ready"/>
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Opacity="0.7" Margin="0,0,0,10" TextWrapping="Wrap"
                 Text="Rip a disc to an ISO, convert BIN/CUE · MDF/MDS · NRG to ISO, mount an image as a drive, or erase a rewritable. The optical image toolkit — no virtual-drive driver required."/>

      <WrapPanel Grid.Row="1" x:Name="ButtonPanel">
        <Button Content="Rip disc → ISO…"      Style="{StaticResource ActionButton}" Click="Rip_Click"/>
        <Button Content="Convert image → ISO…" Style="{StaticResource ActionButton}" Click="Convert_Click"/>
        <Button Content="Mount image…"         Style="{StaticResource ActionButton}" Click="Mount_Click"/>
        <Button Content="Unmount…"             Style="{StaticResource ActionButton}" Click="Unmount_Click"/>
        <Button Content="Erase disc"           Style="{StaticResource ActionButton}" Click="Erase_Click"/>
      </WrapPanel>

      <ProgressBar Grid.Row="2" x:Name="Progress" Height="16" Margin="0,4,0,10"
                   Minimum="0" Maximum="100"/>

      <TextBox Grid.Row="3" x:Name="Log"
               IsReadOnly="True"
               FontFamily="Consolas" FontSize="12"
               VerticalScrollBarVisibility="Auto"
               TextWrapping="Wrap" AcceptsReturn="True"
               Background="Transparent"/>

    </Grid>
  </DockPanel>
</Window>
